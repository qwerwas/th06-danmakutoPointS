 #include "utils.hpp"
 
 BulletManager g_BulletManager;
+
+/* --- Mod: 敌弹 -> 道具 ---
+ * g_BulletsToItems = 0 即完全恢复原版行为。
+ * 激光（SpawnLaserPattern）不在改动范围内，保持原样。
+ */
+i32 g_BulletsToItems = 1;
+ItemType g_BulletItemType = ITEM_POINT; // 得点道具；想要火力就改成 ITEM_POWER_SMALL
+f32 g_BulletItemSpread = 56.0f;         // 模式 0 用：沿着原本子弹该飞的方向炸开多远
+i32 g_BulletItemSample = 1;             // 道具池只有 513 个，弹幕太密时改成 2 或 3
+
+// 运动模式：
+//   0 = 炸开一小段后垂直掉落（Item 的 state 2，只还原方向、不计速度）
+//   1 = 沿原本弹道匀速直线飞行（Item 的自定义 state 3，还原真实速度矢量）
+// g_BulletItemSpeedScale 目前为 1.0，即与子弹完全同速；
+// 代价是道具会很快飞出屏幕、基本收不到（原速本来就是用来杀人的）。
+// 若想在「形状还原」和「能收集」之间折中，把它调到 0.4~0.7。
+i32 g_BulletItemMotionMode = 1;
+f32 g_BulletItemSpeedScale = 1.0f;
+static i32 g_BulletItemSampleCounter = 0;
+
+// 把一个本该生成的敌弹替换成道具，沿原弹道方向散开，避免整组道具重叠在发射点上。
+static i32 SpawnBulletAsItem(const EnemyBulletShooter *bulletProps, f32 bulletAngle, f32 bulletSpeed)
+{
+    ZunVec3 itemPosition;
+    ZunVec3 bulletOffset;
+    ZunVec3 itemTarget;
+
+    if (g_BulletItemSample > 1)
+    {
+        if ((g_BulletItemSampleCounter++ % g_BulletItemSample) != 0)
+        {
+            return 0;
+        }
+    }
+
+    itemPosition = bulletProps->position;
+    itemPosition.z = 0.0f;
+
+    if (g_BulletItemMotionMode != 0)
+    {
+        // 沿原本弹道飞行：速度矢量 = 这一发真实的方向 × 真实弹速 × 缩放系数。
+        ZunVec3 flightVelocity;
+        sincosmul(&flightVelocity, bulletAngle, bulletSpeed * g_BulletItemSpeedScale);
+        flightVelocity.z = 0.0f; // sincosmul 只写 x / y
+        g_ItemManager.SpawnItem(&itemPosition, g_BulletItemType, 3, &flightVelocity);
+        return 0;
+    }
+
+    sincosmul(&bulletOffset, bulletAngle, g_BulletItemSpread);
+    bulletOffset.z = 0.0f; // sincosmul 只写 x / y
+    itemTarget = itemPosition + bulletOffset;
+    itemTarget.z = 0.0f;
+
+    // GAME_REGION_* 是 double 字面量，统一收成 f32 避免窄化转换警告。
+    const f32 leftBound = (f32)GAME_REGION_LEFT + 8.0f;
+    const f32 rightBound = (f32)GAME_REGION_RIGHT - 8.0f;
+    const f32 topBound = (f32)GAME_REGION_TOP + 8.0f;
+    const f32 bottomBound = (f32)GAME_REGION_BOTTOM - 64.0f;
+
+    // 把落点夹在游戏区域内，否则道具会飘出屏幕后被回收。
+    if (itemTarget.x < leftBound)
+    {
+        itemTarget.x = leftBound;
+    }
+    if (itemTarget.x > rightBound)
+    {
+        itemTarget.x = rightBound;
+    }
+    if (itemTarget.y < topBound)
+    {
+        itemTarget.y = topBound;
+    }
+    if (itemTarget.y > bottomBound)
+    {
+        itemTarget.y = bottomBound;
+    }
+
+    g_ItemManager.SpawnItem(&itemPosition, g_BulletItemType, 2, &itemTarget);
+    return 0;
+}
+
 static ChainElem g_BulletManagerCalcChain;
 static ChainElem g_BulletManagerDrawChain;
 static const u32 g_EffectsColorWithTextureBlending[28] = {
@@ -165,6 +246,13 @@ u32 BulletManager::SpawnSingleBullet(const EnemyBulletShooter *bulletProps, i32
         bulletSpeed = g_Rng.GetRandomF32InRange(bulletProps->speed1 - bulletProps->speed2) + bulletProps->speed2;
     }
 
+    // Mod: 敌弹 -> 道具。bulletAngle 到这里已是这一发的真实方向，
+    // 且尚未写入 bullets[]，直接接管即可。激光走 SpawnLaserPattern，不受影响。
+    if (g_BulletsToItems != 0)
+    {
+        return SpawnBulletAsItem(bulletProps, bulletAngle, bulletSpeed);
+    }
+
     bullet->state = 1;
